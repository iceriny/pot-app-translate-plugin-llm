            },
            {
              "label": "SiliconFlow",
              "value": "siliconflow"
            },
            {
              "label": "OpenAI",
              "value": "openai"
            },
            {
              "label": "Ollama（本机）",
              "value": "ollama"
            },
            {
              "label": "自定义 OpenAI 兼容",
              "value": "custom"
            }
          ]
        },
        {
          "key": "apiKey",
          "label": "API 密钥 / API key",
          "control": "password",
          "secret": true,
          "description": "本机 Ollama 可留空。仅发送到你配置的 API 地址。"
        },
        {
          "key": "model",
          "label": "模型 / Model",
          "control": "select",
          "editable": true,
          "default": "",
          "description": "留空使用服务商默认模型；自定义/Ollama 必填，可输入任意模型 ID。",
          "options": [
            {
              "label": "自动（服务商默认）",
