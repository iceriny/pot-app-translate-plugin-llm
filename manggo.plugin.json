            },
            {
              "label": "DeepSeek Chat",
              "value": "deepseek-chat"
            },
            {
              "label": "SiliconFlow DeepSeek V3.1",
              "value": "deepseek-ai/DeepSeek-V3.1"
            },
            {
              "label": "OpenAI GPT-4.1 mini",
              "value": "gpt-4.1-mini"
            }
          ]
        },
        {
          "key": "endpoint",
          "label": "API 地址 / API URL",
          "control": "text",
          "description": "留空用预设。自定义可填 https://host/v1 或完整 /chat/completions 地址；HTTP 仅允许 localhost。"
        },
        {
          "key": "stream",
          "label": "流式输出 / Streaming",
          "control": "boolean",
          "default": true,
          "description": "普通翻译/问答逐字显示；结构化指令与词典完成后一次显示。"
        },
        {
          "key": "maxTokens",
          "label": "最大输出 tokens / Max output tokens",
          "control": "integer",
          "default": 4000,
          "description": "1–131072；须在所选模型限制内。"
        },
        {
          "key": "timeoutSeconds",
          "label": "超时（秒）/ Timeout seconds",
          "control": "integer",
          "default": 60,
          "description": "5–300，超时中止本次请求，不自动重复扣费。"
        },
        {
          "key": "temperature",
          "label": "随机度 / Temperature",
          "control": "decimal",
          "description": "可留空，使用模型默认值；0–2，部分推理模型不支持。"
        },
        {
          "key": "jsonMode",
          "label": "强制 JSON 模式 / JSON mode",
          "control": "boolean",
          "default": false,
          "description": "仅结构化指令/词典使用 response_format。服务商不支持时保持关闭。"
        },
        {
          "key": "instructions",
          "label": "补充要求 / Extra instructions",
          "control": "textarea",
          "description": "例如：保留专业缩写，使用简洁商务文风。"
        },
        {
          "key": "glossary",
          "label": "术语表 / Glossary",
          "control": "textarea",
          "description": "每行 source = preferred translation；翻译时统一术语，不应用于问答。"
        },
        {
          "key": "lang",
          "label": "提示语言 / Help language",
          "control": "select",
          "default": "zh_cn",
          "options": [
            {
              "label": "中文",
              "value": "zh_cn"
            },
            {
              "label": "English",
              "value": "en"
            }
          ]
        }
      ]
    }
  ]
}
